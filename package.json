{
  "name": "dsh-silverwolf-theme",
  "version": "0.4.1",
  "description": "银狼LV.999（Silver Wolf LV.999，欢愉赛季 SP 形态）主题：银白赛博渐变毛玻璃 UI + 侧边栏可编辑的人格设定 + 表情包 / 背景图 / 长期记忆 / 世界书管理 | A Silver Wolf LV.999 (Honkai: Star Rail) theme for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "screenshots.json",
    "stickers.json",
    "Background",
    "meme/*.png",
    "tools/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "persona",
    "silver-wolf",
    "honkai-star-rail"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiyuelianfeng/dsh-silverwolf-theme.git"
  },
  "homepage": "https://github.com/qiyuelianfeng/dsh-silverwolf-theme#readme",
  "bugs": {
    "url": "https://github.com/qiyuelianfeng/dsh-silverwolf-theme/issues"
  },
  "author": "qiyuelianfeng (adapted from berhbro/dsh-cyrene-theme)",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
